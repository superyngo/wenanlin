---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
}
const { title, description, ogImage, ogType } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} ogType={ogType} />
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
